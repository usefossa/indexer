# required: your own Solana RPC and one account stream
FOSSA_RPC_URL=http://127.0.0.1:8899
FOSSA_WS_URL=ws://127.0.0.1:8900

# optional alternative: standard Yellowstone Geyser; takes precedence over WS
# FOSSA_GRPC_URL=https://your-geyser.example
# FOSSA_GRPC_TOKEN=replace-with-your-token-if-required

# local service defaults
FOSSA_BIND=127.0.0.1:8790
FOSSA_PUBLIC_URL=http://127.0.0.1:8790
FOSSA_DATABASE=state/indexer.sqlite
FOSSA_COMMITMENT=confirmed

# public protocol defaults; change together for another deployment/network
FOSSA_PROGRAM_ID=F8q85nw6UScZCBKBJqVAu7ZdYhmT9XRsm6TqZzJqXSNT
FOSSA_MARKET=8wceBTFDAiC9WiT3xZGRf9Nf4xrz8eBCxExBtDWz1Som
